# Accepts n (int) and k (int) from standard input and writes
# C(n, k) = n!/(k!(n-k)!) to standard output.
# Exercises: jsr/jr, divi, subi.

.text

    readi  r3           # read n
    readi  r4           # read k
    copy   r5 r3
    jsr    ra factorial # rv = n!
    copy   r7 rv        # r7 = n!
    copy   r5 r4
    jsr    ra factorial # rv = k!
    divi   r7 r7 rv     # r7 = n! / k!
    subi   r5 r3 r4     # r5 = n - k
    jsr    ra factorial # rv = (n-k)!
    divi   r7 r7 rv     # r7 = n! / (k! (n-k)!)
    writei r7
    halt

# factorial: rv <- n! (iterative)
#   input : r5 = n
#   output: rv = n!
#   temps : r6
factorial:
    seti rv 1           # rv = 1
    copy r6 r5          # i = n
loop:
    jeqz r6 return      # i = 0 -> done
    muli rv rv r6       # rv *= i
    inci r6 -1          # i--
    j    loop
return:
    jr   ra

# Accepts n (int) from standard input and writes n! (computed
# recursively) to standard output.
# Exercises: jsr/jr, pushw/popw, stack frames with fp.

.text

    readi    r3           # read n
    pushw    r3 sp        # mem[sp--] = n
    jsr      ra factorial # rv = factorial(n)
    inci     sp -4        # sp = sp - 4
    writei   rv           # write n!
    halt

# factorial: rv <- n! (recursive)
#   input : r3 = n
#   output: rv = n!
#   temps : r4, r5
factorial:
    pushw ra sp           # mem[sp--] = ra
    pushw fp sp           # mem[sp--] = fp
    copy  fp sp           # fp = sp

    pushw r3 sp           # save registers used
    pushw r4 sp
    pushw r5 sp

    ldw  r3 fp 12         # n = mem[fp + 12]
    jnez r3 rec           # n != 0 -> recursive step (else fall through)

    seti rv 1             # base case: rv = 1
    j    restore

rec:
    copy r5 r3
    inci r5 -1            # r5 = n - 1
    pushw r5 sp           # mem[sp--] = n - 1
    jsr  ra factorial     # rv = (n-1)!
    inci sp 4             # sp = sp + 4
    muli rv r3 rv         # rv = n * (n-1)!

restore:
    popw r5 sp            # restore registers used
    popw r4 sp
    popw r3 sp

    popw fp sp            # restore fp
    popw ra sp            # restore ra
    jr   ra               # return to caller
